rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() { return request.auth != null && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function admin() { return member() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin'; }
    match /staff/{id} {
      allow read: if member() && (request.auth.uid == id || admin());
      allow create, update: if admin() && request.resource.data.role in ['admin','employee'] && request.resource.data.email is string;
      allow delete: if admin() && request.auth.uid != id;
    }
    match /settings/{id} { allow read: if id == 'catalog'; allow write: if admin(); }
    match /products/{id} { allow read: if true; allow write: if admin(); }
    match /productImages/{id} { allow read: if true; allow write: if admin(); }
    match /orders/{id} {
      allow read: if member();
      allow delete: if admin();
      allow create: if request.auth != null && request.resource.data.customerUid == request.auth.uid && request.resource.data.currency == 'DZD' && request.resource.data.payment == 'livraison' && request.resource.data.status == 'nouvelle' && request.resource.data.customer is map && request.resource.data.delivery is map && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30 && request.resource.data.subtotal is int && request.resource.data.shippingFee is int && request.resource.data.total == request.resource.data.subtotal + request.resource.data.shippingFee && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if (member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['nouvelle','expediee','livree','annulee','injoignable']) || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer','delivery','notes','updatedAt'])) || (admin() && resource.data.status in ['nouvelle','injoignable'] && request.resource.data.status == 'expediee' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','yalidine','updatedAt']) && request.resource.data.yalidine.tracking is string);
    }
  }
}
